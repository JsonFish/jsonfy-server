# 本地开发配置模板
#
# cp .env.example .env 后按需修改。
# 生产环境请用 .env.production.example，两者不要混用。

# Nest HTTP 服务
PORT=3001
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=jsonfi

# JWT 密钥：不填也能启动（会生成随机临时值，重启后 token 失效）。
# 想要重启后登录态保持不变，就填两个不同的随机值：openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# GitHub OAuth：前端 NextAuth 与后端使用同一 OAuth App。
# 后端用它验证 NextAuth 交来的 access token，并继续支持 /auth/github code 登录。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 限流（每 IP 每分钟）
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
